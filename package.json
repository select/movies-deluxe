{
  "name": "movies-deluxe",
  "version": "0.13.2",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "build:check": "SKIP_PRERENDER=1 NITRO_OUTPUT_DIR=/tmp/movies-deluxe-build nuxt build && rm -rf /tmp/movies-deluxe-build",
    "dev": "nuxt dev",
    "build:prod": "nuxt generate",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && tsx scripts/copy-sqlite-wasm.ts",
    "prepare": "simple-git-hooks",
    "commitlint": "commitlint --edit",
    "lint": "oxlint && eslint .",
    "lint:fix": "oxlint --fix && eslint . --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "nuxt typecheck",
    "typecheck:watch": "nuxt typecheck --watch",
    "db:generate": "tsx scripts/generate-sqlite.ts",
    "db:migrate:source-status": "tsx scripts/migrate-source-status.ts",
    "movies:merge-stuck": "tsx scripts/merge-stuck-matched.ts",
    "channels:sync": "tsx scripts/sync-channels.ts",
    "posters:extract": "tsx scripts/extract-posters.ts",
    "posters:cleanup": "tsx scripts/cleanup-posters.ts",
    "youtube:setup": "tsx scripts/setup-youtube-api.ts",
    "youtube:detect-blocked": "tsx scripts/detect-blocked-youtube.ts",
    "quality:mark-clips": "tsx scripts/mark-clips.ts",
    "similar:generate": "tsx scripts/generate-similar-movies.ts",
    "posters:scrape-headless": "tsx scripts/scrape-imdb-headless.ts",
    "release": "release-it",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "upcheck": "ncu -i --cooldown 3d"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "commit-msg": "pnpm commitlint --edit $1"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "oxlint",
      "eslint",
      "oxfmt --check --no-error-on-unmatched-pattern"
    ],
    "*.{json,md,yml,yaml}": [
      "oxfmt --check --no-error-on-unmatched-pattern"
    ]
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "@opencode-ai/sdk": "1.19.6",
    "@openrouter/sdk": "1.5.119",
    "@pinia/nuxt": "1.0.3",
    "@types/tar": "7.0.87",
    "@vueuse/core": "15.0.0",
    "@vueuse/integrations": "15.0.0",
    "@vueuse/nuxt": "15.0.0",
    "dotenv": "18.0.10",
    "focus-trap": "8.2.5",
    "fuse.js": "7.5.0",
    "googleapis": "190.0.0",
    "nuxt": "4.6.4",
    "pinia": "4.1.0",
    "sqlite-vec": "0.1.9",
    "sqlite-wasm-vec": "0.1.11",
    "tar": "7.5.23",
    "vue": "3.5.45",
    "vue-router": "5.5.1"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@iconify-json/carbon": "1.2.30",
    "@iconify-json/material-symbols-light": "1.2.102",
    "@iconify-json/mdi": "1.2.3",
    "@mermaid-js/mermaid-cli": "12.2.0",
    "@nuxt/eslint": "1.17.0",
    "@release-it/conventional-changelog": "12.0.2",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@typescript-eslint/eslint-plugin": "8.73.0",
    "@typescript-eslint/parser": "8.73.0",
    "@unocss/nuxt": "66.13.0",
    "@unocss/preset-web-fonts": "66.13.0",
    "@unocss/preset-wind4": "66.13.0",
    "@unocss/reset": "66.13.0",
    "@vitest/ui": "5.1.1",
    "better-sqlite3": "13.2.0",
    "conventional-changelog-angular": "9.4.0",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "eslint": "10.15.0",
    "eslint-plugin-oxlint": "1.94.0",
    "eslint-plugin-vue": "10.12.1",
    "glob": "14.0.6",
    "lint-staged": "17.6.1",
    "npm-check-updates": "23.1.1",
    "nuxt-explicit-imports": "^0.1.0",
    "oxfmt": "^0.79.0",
    "oxlint": "1.94.0",
    "puppeteer": "25.18.1",
    "puppeteer-extra": "3.3.6",
    "puppeteer-extra-plugin-stealth": "2.11.2",
    "release-it": "21.1.2",
    "simple-git-hooks": "2.14.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "typeslayer": "0.1.32",
    "unocss": "66.13.0",
    "vitest": "5.1.1",
    "vue-tsc": "3.3.14",
    "youtubei.js": "18.3.0"
  }
}
