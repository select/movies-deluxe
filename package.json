{
  "name": "movies-deluxe",
  "version": "0.11.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "build:prod": "nuxt generate",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && tsx scripts/copy-sqlite-wasm.ts",
    "prepare": "simple-git-hooks",
    "commitlint": "commitlint --edit",
    "lint": "oxlint && eslint .",
    "lint:fix": "oxlint --fix && eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "nuxt typecheck",
    "typecheck:watch": "nuxt typecheck --watch",
    "db:generate": "tsx scripts/generate-sqlite.ts",
    "posters:extract": "tsx scripts/extract-posters.ts",
    "youtube:setup": "tsx scripts/setup-youtube-api.ts",
    "youtube:detect-blocked": "tsx scripts/detect-blocked-youtube.ts",
    "quality:mark-clips": "tsx scripts/mark-clips.ts",
    "embeddings:generate": "tsx scripts/generate-embeddings.ts",
    "embeddings:generate-bge": "tsx scripts/generate-embeddings-bge.ts",
    "embeddings:generate-potion": "tsx scripts/generate-embeddings-potion.ts",
    "similar:generate": "tsx scripts/generate-similar-movies.ts",
    "embeddings:copy": "tsx scripts/copy-embeddings-db.ts",
    "posters:scrape-headless": "tsx scripts/scrape-imdb-headless.ts",
    "release": "release-it",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "upcheck": "npm-check -u --save-exact"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "commit-msg": "pnpm commitlint --edit $1"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "oxlint",
      "eslint",
      "prettier --check --ignore-path .prettierignore"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --check --ignore-path .prettierignore"
    ]
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "@opencode-ai/sdk": "1.14.48",
    "@openrouter/sdk": "0.12.35",
    "@pinia/nuxt": "0.11.3",
    "@types/tar": "7.0.87",
    "@vueuse/core": "14.3.0",
    "@vueuse/integrations": "14.3.0",
    "@vueuse/nuxt": "14.3.0",
    "dotenv": "17.4.2",
    "focus-trap": "7.7.0",
    "fuse.js": "7.3.0",
    "googleapis": "169.0.0",
    "nuxt": "4.4.5",
    "ollama": "0.6.3",
    "onnxruntime-web": "1.26.0",
    "pinia": "3.0.4",
    "sqlite-vec": "0.1.7-alpha.2",
    "sqlite-wasm-vec": "0.1.11",
    "tar": "7.5.15",
    "vue": "3.5.34",
    "vue-router": "5.0.6"
  },
  "devDependencies": {
    "@commitlint/cli": "21.0.1",
    "@commitlint/config-conventional": "21.0.1",
    "@iconify-json/carbon": "1.2.21",
    "@iconify-json/material-symbols-light": "1.2.71",
    "@iconify-json/mdi": "1.2.3",
    "@mermaid-js/mermaid-cli": "11.14.0",
    "@nuxt/eslint": "1.15.2",
    "@release-it/conventional-changelog": "11.0.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "25.7.0",
    "@typescript-eslint/eslint-plugin": "8.59.3",
    "@typescript-eslint/parser": "8.59.3",
    "@unocss/nuxt": "66.6.8",
    "@unocss/preset-web-fonts": "66.6.8",
    "@unocss/preset-wind4": "66.6.8",
    "@unocss/reset": "66.6.8",
    "@vitest/ui": "4.1.6",
    "better-sqlite3": "12.10.0",
    "conventional-changelog-angular": "8.3.1",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "eslint": "10.3.0",
    "eslint-plugin-oxlint": "1.64.0",
    "eslint-plugin-vue": "10.9.1",
    "glob": "13.0.6",
    "lint-staged": "17.0.4",
    "npm-check": "6.0.1",
    "onnxruntime-node": "1.26.0",
    "oxlint": "1.64.0",
    "prettier": "3.8.3",
    "prettier-plugin-vue": "1.1.6",
    "puppeteer": "24.43.1",
    "puppeteer-extra": "3.3.6",
    "puppeteer-extra-plugin-stealth": "2.11.2",
    "release-it": "20.0.1",
    "simple-git-hooks": "2.13.1",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.3",
    "typeslayer": "0.1.32",
    "unocss": "66.6.8",
    "vitest": "4.1.6",
    "vue-tsc": "3.2.8",
    "youtubei.js": "16.0.1"
  },
  "pnpm": {
    "overrides": {
      "prettier": "3.3.3",
      "onnxruntime-node": "1.23.2"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "puppeteer"
    ]
  }
}
