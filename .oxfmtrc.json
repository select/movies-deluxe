{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "tabWidth": 2,
  "useTabs": false,
  "trailingComma": "es5",
  "printWidth": 100,
  "arrowParens": "avoid",
  "endOfLine": "lf",
  "vueIndentScriptAndStyle": false,
  "singleAttributePerLine": false,
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules",
    "pnpm-lock.yaml",
    ".nuxt",
    ".output",
    "dist",
    "*.log",
    ".DS_Store",
    ".env",
    ".env.*",
    "public/sqlite-wasm",
    ".opencode/",
    ".git",
    "CHANGELOG.md",
    "public/data",
    "public/movies",
    "public/posters",
    "public/models",
    "data/"
  ]
}
